{
  "version": 8,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e2f7d8"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c8eab0"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#c8eab0"
      }
    },
    {
      "id": "landcover_farmland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["farmland", "farm", "orchard"], true, false],
      "paint": {
        "fill-color": "#dcfce7",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landcover_wetland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wetland", "marsh", "swamp", "mangrove"], true, false],
      "paint": {
        "fill-color": "#a7f3d0",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover_sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["sand", "beach"], true, false],
      "paint": {
        "fill-color": "#fef08a",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a8d8ea"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a8d8ea",
        "line-width": 2
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path"], true, false],
      "minzoom": 13.5,
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#c8d1dc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13.5, 1, 16, 3, 19, 7]
      }
    },
    {
      "id": "road_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#00c853",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 2.8, 13.5, 5, 15.5, 9.5, 17.5, 18, 19, 33]
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#8e97a4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 13.5, 3.5, 15.5, 7.5, 17.5, 14.5, 19, 27]
      }
    },
    {
      "id": "road_major_lanes",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "minzoom": 15.8,
      "layout": {
        "line-join": "round",
        "line-cap": "butt"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-dasharray": [4, 6],
        "line-width": ["interpolate", ["linear"], ["zoom"], 15.8, 0.9, 18, 1.6],
        "line-opacity": 0.88
      }
    },
    {
      "id": "road_major_center",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "minzoom": 15.8,
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#facc15",
        "line-width": ["interpolate", ["linear"], ["zoom"], 15.8, 1.1, 18, 1.8],
        "line-opacity": 0.9
      }
    },
    {
      "id": "3d-buildings",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14.2,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "render_height"], 8],
          0, "#fef3e7",
          8, "#faeee0",
          18, "#fed7aa",
          35, "#fcd34d",
          60, "#fbcfe8"
        ],
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14.2, 0,
          15.2, ["*", ["coalesce", ["get", "render_height"], 8], 0.7],
          16, ["coalesce", ["get", "render_height"], 8]
        ],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14.2, 0,
          14.8, 0.65,
          16, 0.86,
          19, 0.82
        ],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#777777",
        "text-halo-color": "#e2f7d8",
        "text-halo-width": 1
      }
    },
    {
      "id": "place_label_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 18]
      },
      "paint": {
        "text-color": "#2c3e50",
        "text-halo-color": "#e2f7d8",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_label_other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["!=", ["get", "class"], "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 16, 14]
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#e2f7d8",
        "text-halo-width": 1
      }
    }
  ]
}