{
  "version": 8,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "terrainSource": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15
    }
  },
  "terrain": {
    "source": "terrainSource",
    "exaggeration": 1.0
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "viewport",
    "color": "#ffffff",
    "intensity": 0.52,
    "position": [1.5, 135, 55]
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#dcfce7"
      }
    },
    {
      "id": "hills",
      "type": "hillshade",
      "source": "terrainSource",
      "paint": {
        "hillshade-shadow-color": "#064e3b",
        "hillshade-highlight-color": "#fef9c3",
        "hillshade-accent-color": "#059669",
        "hillshade-exaggeration": 0.45
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#bbf7d0"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#bbf7d0"
      }
    },
    {
      "id": "landcover_farmland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["farmland", "farm", "orchard"], true, false],
      "paint": {
        "fill-color": "#d1fae5",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landcover_wetland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wetland", "marsh", "swamp", "mangrove"], true, false],
      "paint": {
        "fill-color": "#a7f3d0",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover_sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["sand", "beach"], true, false],
      "paint": {
        "fill-color": "#fef08a",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#7dd3fc"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#38bdf8",
        "line-width": 2.5
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "residential"], true, false],
      "minzoom": 16.0,
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 16, 2.5, 19, 8]
      }
    },
    {
      "id": "road_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#94a3b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.8, 10, 3.2, 13.5, 5.8, 15.5, 10.5, 17.5, 19, 19, 34]
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.0, 10, 2.0, 13.5, 4.0, 15.5, 8.5, 17.5, 15.5, 19, 28]
      }
    },
    {
      "id": "road_major_lanes",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "minzoom": 16.5,
      "layout": {
        "line-join": "round",
        "line-cap": "butt"
      },
      "paint": {
        "line-color": "#94a3b8",
        "line-dasharray": [4, 6],
        "line-width": ["interpolate", ["linear"], ["zoom"], 16.5, 1.0, 18, 1.6],
        "line-opacity": 0.8
      }
    },
    {
      "id": "road_major_center",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary"], true, false],
      "minzoom": 16.5,
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#f59e0b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 16.5, 1.2, 18, 1.8],
        "line-opacity": 0.9
      }
    },
    {
      "id": "2d-buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16.0,
      "maxzoom": 16.5,
      "paint": {
        "fill-color": "#ffffff",
        "fill-outline-color": "#cbd5e1",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "3d-buildings",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16.2,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "render_height"], 8],
          0, "#ffffff",
          8, "#fafaf9",
          18, "#f5f5f4",
          35, "#fed7aa",
          60, "#fde047"
        ],
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          16.2, 0,
          16.6, [
            "coalesce",
            ["get", "render_height"],
            ["get", "height"],
            ["*", ["coalesce", ["get", "levels"], ["get", "building:levels"], 1.5], 4.2],
            9.5
          ]
        ],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          16.2, 0,
          16.5, 0.96,
          19, 0.95
        ],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "minzoom": 13.0,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#dcfce7",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_label_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 18]
      },
      "paint": {
        "text-color": "#2c3e50",
        "text-halo-color": "#e2f7d8",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_label_other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["!=", ["get", "class"], "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 16, 14]
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#e2f7d8",
        "text-halo-width": 1
      }
    }
  ]
}