{
  "version": 8,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "terrainSource": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15
    }
  },
  "terrain": {
    "source": "terrainSource",
    "exaggeration": 1.0
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "map",
    "color": "#fffbeb",
    "intensity": 0.65,
    "position": [1.5, 210, 45]
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#c2e2c9"
      }
    },
    {
      "id": "hills",
      "type": "hillshade",
      "source": "terrainSource",
      "paint": {
        "hillshade-shadow-color": "#0f3a22",
        "hillshade-highlight-color": "#fff7ed",
        "hillshade-accent-color": "#166534",
        "hillshade-exaggeration": 0.65
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#86efac"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#5b9468",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover_farmland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["farmland", "farm", "orchard"], true, false],
      "paint": {
        "fill-color": "#a7d7b5",
        "fill-opacity": 0.88
      }
    },
    {
      "id": "landcover_wetland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wetland", "marsh", "swamp", "mangrove"], true, false],
      "paint": {
        "fill-color": "#6ee7b7",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover_sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["sand", "beach"], true, false],
      "paint": {
        "fill-color": "#fde68a",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#38bdf8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#0284c7",
        "line-width": 2.5
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "residential"], true, false],
      "minzoom": 16.0,
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#475569",
        "line-width": ["interpolate", ["linear"], ["zoom"], 16, 3.2, 19, 9]
      }
    },
    {
      "id": "road_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#0f172a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 2.0, 10, 3.6, 13.5, 6.2, 15.5, 11.0, 17.5, 20.0, 19, 36]
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#334155",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.2, 10, 2.4, 13.5, 4.5, 15.5, 9.0, 17.5, 16.5, 19, 29]
      }
    },
    {
      "id": "road_major_lanes",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "minzoom": 16.5,
      "layout": {
        "line-join": "round",
        "line-cap": "butt"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-dasharray": [4, 6],
        "line-width": ["interpolate", ["linear"], ["zoom"], 16.5, 1.2, 18, 1.8],
        "line-opacity": 0.85
      }
    },
    {
      "id": "road_major_center",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary"], true, false],
      "minzoom": 16.5,
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#f59e0b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 16.5, 1.4, 18, 2.2],
        "line-opacity": 0.95
      }
    },
    {
      "id": "2d-buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16.0,
      "maxzoom": 16.5,
      "paint": {
        "fill-color": "#c2410c",
        "fill-outline-color": "#9a3412",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "3d-buildings",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16.2,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "render_height"], ["*", ["coalesce", ["get", "levels"], ["get", "building:levels"], 1.5], 4.2], 8],
          3, "#fef3c7",
          6, "#c2410c",
          8, "#ea580c",
          12, "#d97706",
          18, "#e2d9cc",
          28, "#cbd5e1",
          50, "#94a3b8"
        ],
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          16.2, 0,
          16.6, [
            "coalesce",
            ["get", "render_height"],
            ["get", "height"],
            ["*", ["coalesce", ["get", "levels"], ["get", "building:levels"], 1.5], 4.2],
            9.5
          ]
        ],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          16.2, 0,
          16.5, 0.96,
          19, 0.95
        ],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "minzoom": 13.0,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#1e293b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_label_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 18]
      },
      "paint": {
        "text-color": "#1e293b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place_label_other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["!=", ["get", "class"], "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 16, 14]
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}